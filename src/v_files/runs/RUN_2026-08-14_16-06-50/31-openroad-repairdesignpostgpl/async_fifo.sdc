current_design async_fifo
###############################################################################
# Timing Constraints
###############################################################################
create_clock -name wclk -period 10.0000 [get_ports {wclk}]
create_clock -name rclk -period 14.0000 [get_ports {rclk}]
set_clock_groups -name async_fifo_clocks -asynchronous \
 -group [get_clocks {rclk}]\
 -group [get_clocks {wclk}]
